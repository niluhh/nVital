// Settings shared by every nVital target.

// Reverse-DNS prefix for all bundle identifiers. Change it here if you use
// your own domain (e.g. com.example) and regenerate the project:
//   app        -> $(NVITAL_BUNDLE_ID_PREFIX).nvital
//   framework  -> $(NVITAL_BUNDLE_ID_PREFIX).nvital.core
NVITAL_BUNDLE_ID_PREFIX = com.nil

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

MACOSX_DEPLOYMENT_TARGET = 10.13
SWIFT_VERSION = 5.0

// Universal binary: Intel and Apple Silicon.
ARCHS = $(ARCHS_STANDARD)
ONLY_ACTIVE_ARCH[config=Debug] = YES
ONLY_ACTIVE_ARCH[config=Release] = NO

// Ad-hoc signing by default so it builds without a developer account.
// Set your team and a Developer ID identity to distribute notarized builds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
